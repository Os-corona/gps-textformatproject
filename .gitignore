# ==========================================
# PrettyDocs - Git Ignore
# ==========================================

# --- Entornos virtuales ---
.venv/
venv/
env/

# --- Variables de entorno / credenciales ---
.env
.env.*
!.env.example

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# --- Django ---
*.log
db.sqlite3
db.sqlite3-journal
media/
staticfiles/

# --- Node.js ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Frontend / builds ---
dist/
build/
.vite/

# --- IDEs / Editores ---
.vscode/
.idea/
*.swp
*.swo

# --- Sistema operativo ---
.DS_Store
Thumbs.db
desktop.ini

# --- Archivos temporales ---
*.tmp
*.temp
*.bak
*.swp

# --- Cobertura / testing ---
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/

# --- Archivos generados ---
*.log