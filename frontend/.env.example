VITE_API_URL=http://localhost:8000/api
VITE_USE_MOCKS=false

# ─── Review screen mocks (only when VITE_USE_MOCKS=true) ─────────────────────
# Simulate the job status returned while polling:
# VITE_MOCK_JOB_STATUS=review
# Generate a 100-block review payload to test the large-document layout:
# VITE_MOCK_REVIEW_LARGE=true
# Or generate an arbitrary number of proposed blocks (max 500):
# VITE_MOCK_REVIEW_BLOCKS=100
# Simulate loading/decision errors:
# VITE_MOCK_STRUCTURE_ERROR=invalid_state
# VITE_MOCK_REVIEW_ERROR=processing_error
