DB_NAME=db
DB_USER=postgres
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5432

# Configuración de IA (OpenRouter)
AI_PROVIDER=openrouter
AI_API_KEY=
AI_MODEL=openai/gpt-6-luna
AI_TIMEOUT_S=30
AI_BASE_URL=https://openrouter.ai/api/v1
AI_TEMPERATURE=0.2
AI_SITE_URL=http://localhost:5173
AI_APP_NAME=PrettyDocs

AI_MAX_BOLD_RATIO=0.30
AI_MAX_HEADING_WORDS=20
AI_MIN_TOKEN_RETENTION=0.95
AI_MAX_ADDED_TOKEN_RATIO=0.05
AI_MAX_GENERATED_HEADING_WORDS=6
JOB_RUNNER=thread
JOB_RUNNER_MAX_WORKERS=2
