{
  "id": "reporte",
  "name": "Reporte ejecutivo",
  "description": "Calibri 11, interlineado 1.15, márgenes de 2.5 cm, texto justificado y encabezado de tabla sombreado.",
  "config": {
    "margins_cm": {
      "top": 2.5,
      "bottom": 2.5,
      "left": 2.5,
      "right": 2.5
    },
    "font_family": "Calibri",
    "font_size_pt": 11,
    "line_spacing": 1.15,
    "heading_sizes_pt": {
      "h1": 16,
      "h2": 14,
      "h3": 12
    },
    "paragraph": {
      "alignment": "justify",
      "first_line_indent_cm": 0.0,
      "space_after_pt": 6.0
    },
    "headings": {
      "h1": {
        "size_pt": 16,
        "bold": true,
        "align": "left",
        "space_before_pt": 12.0,
        "space_after_pt": 6.0,
        "color": "1F497D"
      },
      "h2": {
        "size_pt": 14,
        "bold": true,
        "align": "left",
        "space_before_pt": 10.0,
        "space_after_pt": 4.0,
        "color": "595959"
      },
      "h3": {
        "size_pt": 12,
        "bold": true,
        "align": "left",
        "space_before_pt": 8.0,
        "space_after_pt": 2.0
      }
    },
    "tables": {
      "header_bold": true,
      "header_fill": "D9E1F2",
      "cell_line_spacing": 1.0
    },
    "page_numbers": true
  }
}
