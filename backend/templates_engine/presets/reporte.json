{
  "id": "reporte",
  "name": "Reporte ejecutivo",
  "description": "Calibri 11, interlineado 1.15, márgenes de 2.5 cm, texto justificado y encabezado de tabla sombreado.",
  "config": {
    "margins_cm": {
      "top": 2.5,
      "bottom": 2.5,
      "left": 2.5,
      "right": 2.5
    },
    "font_family": "Calibri",
    "font_size_pt": 11,
    "line_spacing": 1.15,
    "heading_sizes_pt": {
      "h1": 16,
      "h2": 14,
      "h3": 12
    },
    "paragraph": {
      "alignment": "justify",
      "first_line_indent_cm": 0.0,
      "space_after_pt": 6.0,
      "accent_border_color": "B4C6E7"
    },
    "headings": {
      "title": {
        "size_pt": 20,
        "bold": true,
        "align": "left",
        "space_before_pt": 0.0,
        "space_after_pt": 12.0,
        "color": "1F497D",
        "bottom_border": "1F497D"
      },
      "h1": {
        "size_pt": 16,
        "bold": true,
        "align": "left",
        "space_before_pt": 16.0,
        "space_after_pt": 6.0,
        "color": "1F497D",
        "bottom_border": "2F5496"
      },
      "h2": {
        "size_pt": 13.5,
        "bold": true,
        "align": "left",
        "space_before_pt": 12.0,
        "space_after_pt": 4.0,
        "color": "2F5496",
        "left_border": "2F5496"
      },
      "h3": {
        "size_pt": 12,
        "bold": true,
        "align": "left",
        "space_before_pt": 8.0,
        "space_after_pt": 2.0,
        "color": "1F497D"
      }
    },
    "lists": {
      "indent_cm_per_level": 0.75
    },
    "callout": {
      "italic": true,
      "left_indent_cm": 0.9,
      "fill": "F2F5F9",
      "border_color": "1F497D"
    },
    "tables": {
      "header_bold": true,
      "header_fill": "D9E1F2",
      "header_text_color": "1F497D",
      "zebra_fill": "F7F9FC",
      "border_style": "grid",
      "border_color": "BFBFBF",
      "cell_line_spacing": 1.0
    },
    "page_numbers": true
  }
}
