{
  "$defs": {
    "HeadingOutBlock": {
      "description": "Título o encabezado jerárquico con nivel estricto entre 1 y 6.",
      "properties": {
        "type": {
          "const": "heading",
          "default": "heading",
          "title": "Type",
          "type": "string"
        },
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "ID único del bloque",
          "title": "Id"
        },
        "level": {
          "description": "Nivel del título (1 a 6: H1, H2, H3, H4, H5, H6)",
          "maximum": 6,
          "minimum": 1,
          "title": "Level",
          "type": "integer"
        },
        "runs": {
          "description": "Runs de texto que forman el título",
          "items": {
            "$ref": "#/$defs/Run"
          },
          "minItems": 1,
          "title": "Runs",
          "type": "array"
        },
        "hints": {
          "anyOf": [
            {
              "$ref": "#/$defs/Hints"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Pistas opcionales"
        }
      },
      "required": [
        "level",
        "runs"
      ],
      "title": "HeadingOutBlock",
      "type": "object"
    },
    "Hints": {
      "additionalProperties": true,
      "description": "Pistas y sugerencias tipográficas o jerárquicas emitidas por el extractor o la IA.",
      "properties": {
        "style_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Nombre del estilo original en el documento de Word",
          "title": "Style Name"
        },
        "suggested_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Tipo sugerido por extractor o IA (e.g. 'heading')",
          "title": "Suggested Type"
        },
        "suggested_level": {
          "anyOf": [
            {
              "maximum": 9,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Nivel jerárquico sugerido (0 a 9)",
          "title": "Suggested Level"
        },
        "is_list": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Indica si el bloque parece pertenecer a una lista",
          "title": "Is List"
        },
        "is_numbered": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Indica si la lista es numerada o viñeta",
          "title": "Is Numbered"
        },
        "list_level": {
          "anyOf": [
            {
              "maximum": 8,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Nivel de anidamiento de lista (0 a 8)",
          "title": "List Level"
        },
        "has_inline_image": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Indica si el bloque contiene imágenes embebidas",
          "title": "Has Inline Image"
        },
        "keep_with_next": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Regla de maquetación: mantener con el párrafo siguiente",
          "title": "Keep With Next"
        },
        "grammar_checked": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Indica si el texto pasó por revisión gramatical",
          "title": "Grammar Checked"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Nivel de certeza de la sugerencia",
          "title": "Confidence"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Notas explicativas adicionales",
          "title": "Notes"
        }
      },
      "title": "Hints",
      "type": "object"
    },
    "ImageOutBlock": {
      "description": "Bloque de imagen preservada.",
      "properties": {
        "type": {
          "const": "image",
          "default": "image",
          "title": "Type",
          "type": "string"
        },
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "ID único del bloque",
          "title": "Id"
        },
        "image_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Ruta o URI de la imagen",
          "title": "Image Path"
        },
        "caption": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Pie de imagen opcional",
          "title": "Caption"
        },
        "hints": {
          "anyOf": [
            {
              "$ref": "#/$defs/Hints"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Pistas opcionales"
        }
      },
      "title": "ImageOutBlock",
      "type": "object"
    },
    "ListItemOutBlock": {
      "description": "Elemento de lista (viñeta o numerada) con nivel de anidamiento entre 0 y 8.",
      "properties": {
        "type": {
          "const": "list_item",
          "default": "list_item",
          "title": "Type",
          "type": "string"
        },
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "ID único del bloque",
          "title": "Id"
        },
        "level": {
          "default": 0,
          "description": "Nivel de anidamiento de la lista (0 a 8)",
          "maximum": 8,
          "minimum": 0,
          "title": "Level",
          "type": "integer"
        },
        "is_numbered": {
          "default": false,
          "description": "True si es lista numerada, False si es viñeta",
          "title": "Is Numbered",
          "type": "boolean"
        },
        "runs": {
          "description": "Runs de texto del elemento de lista",
          "items": {
            "$ref": "#/$defs/Run"
          },
          "minItems": 1,
          "title": "Runs",
          "type": "array"
        },
        "hints": {
          "anyOf": [
            {
              "$ref": "#/$defs/Hints"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Pistas opcionales"
        }
      },
      "required": [
        "runs"
      ],
      "title": "ListItemOutBlock",
      "type": "object"
    },
    "ParagraphOutBlock": {
      "description": "Párrafo normal de texto procesado.",
      "properties": {
        "type": {
          "const": "paragraph",
          "default": "paragraph",
          "title": "Type",
          "type": "string"
        },
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "ID único del bloque",
          "title": "Id"
        },
        "runs": {
          "description": "Runs de texto que forman el párrafo",
          "items": {
            "$ref": "#/$defs/Run"
          },
          "minItems": 1,
          "title": "Runs",
          "type": "array"
        },
        "hints": {
          "anyOf": [
            {
              "$ref": "#/$defs/Hints"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Pistas opcionales de formato"
        }
      },
      "required": [
        "runs"
      ],
      "title": "ParagraphOutBlock",
      "type": "object"
    },
    "Run": {
      "description": "Segmento de texto continuo con un formato tipográfico consistente.",
      "properties": {
        "text": {
          "description": "Texto contenido en el run (no vacío)",
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "bold": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Indica si el texto tiene formato negrita",
          "title": "Bold"
        },
        "italic": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Indica si el texto tiene formato cursiva",
          "title": "Italic"
        },
        "underline": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Indica si el texto tiene subrayado",
          "title": "Underline"
        },
        "font": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Nombre de la fuente (e.g. 'Calibri')",
          "title": "Font"
        },
        "size": {
          "anyOf": [
            {
              "minimum": 1.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Tamaño de la fuente en puntos tipográficos (pt)",
          "title": "Size"
        },
        "color": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Color en hexadecimal o nombre",
          "title": "Color"
        }
      },
      "required": [
        "text"
      ],
      "title": "Run",
      "type": "object"
    },
    "TableCell": {
      "additionalProperties": true,
      "description": "Celda individual dentro de una fila de tabla.",
      "properties": {
        "text": {
          "default": "",
          "description": "Texto plano extraído de la celda",
          "title": "Text",
          "type": "string"
        },
        "runs": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Run"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Runs detallados con formato dentro de la celda",
          "title": "Runs"
        },
        "h_span": {
          "default": 1,
          "description": "Extensión horizontal (column span / gridSpan)",
          "minimum": 1,
          "title": "H Span",
          "type": "integer"
        },
        "v_merge": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Fusión vertical ('restart', 'continue' o None)",
          "title": "V Merge"
        },
        "hints": {
          "anyOf": [
            {
              "$ref": "#/$defs/Hints"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Pistas opcionales sobre la celda"
        }
      },
      "title": "TableCell",
      "type": "object"
    },
    "TableOutBlock": {
      "description": "Tabla rectangular de celdas considerando la propiedad h_span.",
      "properties": {
        "type": {
          "const": "table",
          "default": "table",
          "title": "Type",
          "type": "string"
        },
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "ID único del bloque",
          "title": "Id"
        },
        "rows": {
          "description": "Filas de la tabla",
          "items": {
            "items": {
              "$ref": "#/$defs/TableCell"
            },
            "type": "array"
          },
          "minItems": 1,
          "title": "Rows",
          "type": "array"
        },
        "hints": {
          "anyOf": [
            {
              "$ref": "#/$defs/Hints"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Pistas opcionales de formato de tabla"
        }
      },
      "required": [
        "rows"
      ],
      "title": "TableOutBlock",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "description": "Estructura de salida generada por la IA tras el análisis y reestructuración del chunk.",
  "properties": {
    "schema_version": {
      "default": "di.v1",
      "description": "Versión del esquema de documento intermedio",
      "title": "Schema Version",
      "type": "string"
    },
    "chunk_id": {
      "description": "Identificador del chunk al que corresponde esta salida",
      "title": "Chunk Id",
      "type": "string"
    },
    "blocks": {
      "description": "Lista de bloques estructurados de salida",
      "items": {
        "description": "Bloque de salida discriminado por 'type'",
        "discriminator": {
          "mapping": {
            "heading": "#/$defs/HeadingOutBlock",
            "image": "#/$defs/ImageOutBlock",
            "list_item": "#/$defs/ListItemOutBlock",
            "paragraph": "#/$defs/ParagraphOutBlock",
            "table": "#/$defs/TableOutBlock"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/ParagraphOutBlock"
          },
          {
            "$ref": "#/$defs/HeadingOutBlock"
          },
          {
            "$ref": "#/$defs/ListItemOutBlock"
          },
          {
            "$ref": "#/$defs/TableOutBlock"
          },
          {
            "$ref": "#/$defs/ImageOutBlock"
          }
        ]
      },
      "title": "Blocks",
      "type": "array"
    },
    "summary": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Resumen breve de las correcciones o mejoras aplicadas",
      "title": "Summary"
    },
    "hints": {
      "anyOf": [
        {
          "$ref": "#/$defs/Hints"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Pistas generales generadas por el modelo"
    },
    "metadata": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "description": "Metadatos auxiliares del proveedor",
      "title": "Metadata"
    }
  },
  "required": [
    "chunk_id"
  ],
  "title": "AIChunkOutput",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema_version": "di.v1"
}
